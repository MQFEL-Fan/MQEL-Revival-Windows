# Beispiel: Spielserver als systemd-Dienst unter eigenem Benutzer ohne Rechte.
# Installation (Pfad /opt/mqel und Benutzer mqel anpassen):
#   useradd --system --home /opt/mqel mqel; chown -R mqel: /opt/mqel/server/state
#   cp server/systemd/*.service /etc/systemd/system/
#   systemctl enable --now mqel-chat mqel-game
# Firewall: 8081/tcp (Spiel), 8443/tcp (Spiel, TLS), 80/tcp und 443/tcp (Projektseite) und 5222/tcp (Chat) öffnen.
[Unit]
Description=Mighty Quest game server
After=network.target

[Service]
User=mqel
Group=mqel
WorkingDirectory=/opt/mqel
ExecStart=/usr/bin/python3 -u server/game_server.py --host 0.0.0.0 --port 8081 --profile new --log server/state/requests.log.jsonl --tls-port 8443 --tls-cert server/state/tls/le/fullchain.pem --tls-key server/state/tls/le/privkey.pem --client-exe client/GameData/Bin/MightyQuest_player.exe --web-port 80 --web-tls-port 443 --web-cert server/state/tls/le/fullchain.pem --web-key server/state/tls/le/privkey.pem
Restart=on-failure
RestartSec=5

# Absicherung: nur server/state ist beschreibbar
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# website/: blings.html (und .well-known/ für certbot, schreibt als root) entsteht beim Start und beim Speichern der Economy-Seite
ReadWritePaths=/opt/mqel/server/state /opt/mqel/website
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Port 80 ohne Root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
